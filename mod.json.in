{
  "id": "com.giorgiomendieta.dof_hq",
  "name": "Cinematic Depth of Field",
  "version": "1.0.3",
  "author": "Giorgio Mendieta",
  "description": "Replaces the built-in depth of field for a more cinematic look, optionally blurring objects in the distance during normal gameplay. IMPORTANT: Set the built-in depth of field to Off while this mod is enabled (Settings > Video > Post-processing > Depth of Field)."
}
